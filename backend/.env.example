# Backend Environment Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="MoodTune AI"
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-in-production
DATABASE_URL=sqlite+aiosqlite:///./moodtune.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Jev System One / TypeSafe AI API (optional, deterministic fallback active if empty)
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=typesafe/jev-1.13
LLM_API_KEY=

# Music Provider
MUSIC_PROVIDER_TYPE=local
MUSIC_PROVIDER_API_KEY=
MUSIC_PROVIDER_SECRET=

# Thresholds
CONFIDENCE_HIGH_THRESHOLD=0.70
CONFIDENCE_MEDIUM_THRESHOLD=0.40
# Temporal Smoothing & Stability (Phase 4)
MOOD_WINDOW_SIZE=5
MOOD_MIN_STABLE_DURATION=3.0
MOOD_CHANGE_THRESHOLD=0.25
MOOD_CONFIDENCE_THRESHOLD=0.60
SMOOTHING_WINDOW_SIZE=5
SMOOTHING_EMA_ALPHA=0.35
MINIMUM_STABLE_DURATION_SECONDS=3.0
HYSTERESIS_TRANSITION_THRESHOLD=0.25
MIN_PLAY_SECONDS_BEFORE_TRANSITION=30
FORCE_TRANSITION_PLAY_RATIO=0.85
MAX_RECENT_TRANSITIONS_PER_WINDOW=3
STORE_RAW_FRAMES=false
RETENTION_DAYS_MOOD_HISTORY=7
